{
  "host": "127.0.0.1",
  "port": 8972,
  "open_browser": true,
  "rest_bases": [
    "https://api.hbdm.com",
    "https://api.btcgateway.pro",
    "https://api.hbdm.vip"
  ],
  "tls_verify": true,
  "http_timeout_sec": 12.0,
  "http_retries": 2,
  "symbols": [
    "BTC-USDT",
    "ETH-USDT",
    "SOL-USDT",
    "XRP-USDT",
    "DOGE-USDT",
    "BNB-USDT",
    "LTC-USDT",
    "LINK-USDT",
    "AVAX-USDT",
    "ADA-USDT"
  ],
  "account": {
    "equity_usdt": 450.0,
    "risk_pct_per_trade": 2.0,
    "max_leverage": 10,
    "preferred_leverage": 10,
    "max_margin_pct": 50.0
  },
  "analysis": {
    "tf_periods": [
      "1min",
      "5min",
      "15min",
      "60min",
      "1day"
    ],
    "kline_size": 300,
    "score_threshold": 30,
    "cache_ttl_sec": 20,
    "snapshot_ttl_sec": 20
  },
  "schedule": {
    "enabled": false,
    "interval_sec": 300,
    "symbols": [
      "BTC-USDT"
    ],
    "run_on_start": true,
    "only_on_signal": false
  },
  "storage": {
    "db_file": "data/signals.db",
    "keep_days": 30
  }
}
